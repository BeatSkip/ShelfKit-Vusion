# Build output (regenerated by the SDCC-MDF extension)
build/
# the vendor reference bootloader project at the repo root, NOT ShelfKit-Firmware/Bootloader
/bootloader/

# SDCC intermediates
*.rel
*.lst
*.sym
*.rst
*.asm
# ...except the hand-written startup the bootloader target compiles
!/ShelfKit-Firmware/Bootloader/src/*.asm
*.adb
*.cdb
*.omf
*.ihx
*.hex
*.bin
*.map
*.mem
*.lk

# Python bytecode (created by importing ShelfKit-Firmware/Tooling/*.py helpers)
__pycache__/
*.pyc

# ShelfKit-Server state: the SQLite database plus its WAL sidecars
ShelfKit-Server/data/

# Ready-to-flash HEX files from ShelfKit-Firmware/Tooling/build-all.py
Release/
